generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Agency {
  id           String       @id @default(uuid())
  name         String
  email        String?
  phone        String?
  address      String?
  status       AgencyStatus @default(ACTIVE)
  // true only for the single "agence historique" created by the Phase 1
  // migration to hold pre-existing data. Never assigned to a new signup.
  isInternal   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users        User[]
  applications Application[]
  auditLogs    AuditLog[]
  subscription Subscription?
  stepTemplates StepTemplate[]

  @@map("agency")
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  priceFcfa     Int
  // null = unlimited
  maxAgents     Int?
  maxClients    Int?
  isPublic      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions        Subscription[] @relation("PlanSubscriptions")
  pendingSubscriptions Subscription[] @relation("PendingPlanSubscriptions")
  targetPlanPayments   Payment[]      @relation("TargetPlanPayments")

  @@map("plan")
}

model Subscription {
  id                String             @id @default(uuid())
  agencyId          String             @unique
  planId            String
  // set when a plan change is scheduled to take effect at the end of the
  // current billing period (e.g. a downgrade), instead of immediately.
  pendingPlanId     String?
  status            SubscriptionStatus @default(ACTIVE)
  autoRenew         Boolean            @default(true)
  currentPeriodEnd  DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  agency            Agency             @relation(fields: [agencyId], references: [id])
  plan              Plan               @relation("PlanSubscriptions", fields: [planId], references: [id])
  pendingPlan       Plan?              @relation("PendingPlanSubscriptions", fields: [pendingPlanId], references: [id])
  payments          Payment[]

  @@map("subscription")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Payment {
  id               String        @id @default(uuid())
  subscriptionId   String
  amountFcfa       Int
  // Null while the payment is still PENDING — Flutterwave tells us which
  // method the payer actually used once the charge completes.
  method           PaymentMethod?
  status           PaymentStatus @default(PENDING)
  // Flutterwave tx_ref. Unique so a webhook/redirect retry can never be
  // applied twice.
  reference        String?       @unique
  // Flutterwave's own numeric transaction id, filled in once verified.
  flwTransactionId String?
  // Plan this payment is meant to unlock once it succeeds. Only set for
  // upgrade payments awaiting confirmation.
  targetPlanId     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  subscription     Subscription  @relation(fields: [subscriptionId], references: [id])
  targetPlan       Plan?         @relation("TargetPlanPayments", fields: [targetPlanId], references: [id])

  @@index([subscriptionId])
  @@map("payment")
}

enum PaymentMethod {
  MTN_MOBILE_MONEY
  ORANGE_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  agentId          String?
  // Nullable for now: existing rows get backfilled by the Phase 1 migration
  // script into the "agence historique" before this is ever made required.
  agencyId         String?
  password         String?
   // True right after an admin/agent creates the account with a temporary
  // password. Forces a password change on first login, so the admin/agent
  // who created the account never knows the client's/agent's real password.
  mustChangePassword Boolean         @default(false)
  isSuspended      Boolean           @default(false)
  address          String?
  dateOfBirth      DateTime?
  maritalStatus    MaritalStatus?
  nationality      String?
  numberOfChildren Int               @default(0)
  phoneNumber      String?
  profileCompleted Boolean           @default(false)
  role             Role              @default(CLIENT)
  status           UserStatus        @default(ACTIVE)
  assignedApps     Application[]     @relation("AgentApplications")
  applications     Application[]     @relation("ClientApplications")
  authoredLogs     AuditLog[]        @relation("AuthorLogs")
  documents        Document[]
  messages         Message[]
  receivedMessages OfficialMessage[] @relation("ReceivedMessages")
  sentMessages     OfficialMessage[] @relation("SentMessages")
  accounts         Account[]
  sessions         Session[]
  agent            User?             @relation("AgentClients", fields: [agentId], references: [id])
  assignedClients  User[]            @relation("AgentClients")
  agency           Agency?           @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Application {
  id        String            @id @default(uuid())
  country   String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  clientId  String
  agentId   String?
  agencyId  String?
  type      ApplicationType   @default(PR)
  agent     User?             @relation("AgentApplications", fields: [agentId], references: [id])
  client    User              @relation("ClientApplications", fields: [clientId], references: [id])
  agency    Agency?           @relation(fields: [agencyId], references: [id])
  steps     ApplicationStep[]

  @@index([agencyId])
}

model Message {
  id          String          @id @default(uuid())
  content     String
  createdAt   DateTime        @default(now())
  procedureId String
  senderId    String
  Procedure   ApplicationStep @relation(fields: [procedureId], references: [id])
  sender      User            @relation(fields: [senderId], references: [id])
}

model OfficialMessage {
  id         String   @id @default(uuid())
  subject    String
  content    String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Document {
  id          String          @id @default(uuid())
  name        String
  fileUrl     String
  status      DocumentStatus  @default(UPLOADED)
  uploadedAt  DateTime        @default(now())
  procedureId String
  uploaderId  String
  type        DocumentType    @default(OTHER)
  Procedure   ApplicationStep @relation(fields: [procedureId], references: [id])
  uploader    User            @relation(fields: [uploaderId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String?
  agencyId  String?
  createdAt DateTime @default(now())
  logNumber Int      @unique @default(autoincrement())
  targetId  String?
  author    User?    @relation("AuthorLogs", fields: [userId], references: [id])
  agency    Agency?  @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model ApplicationStep {
  id            String          @id @default(uuid())
  description   String?
  status        ProcedureStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  applicationId String
  isLocked      Boolean         @default(false)
  type          ProcedureType
  // Materialized from the agency's StepTemplate at the time this step was
  // created, so the position/wording of an in-progress application never
  // shifts under it if the admin edits the template afterwards.
  order         Int             @default(0)
  label         String?
  Document      Document[]
  Message       Message[]
  application   Application     @relation(fields: [applicationId], references: [id])

  @@map("Procedure")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  CLIENT
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum DocumentType {
  PASSPORT
  PASSPORT_PHOTO
  BIRTH_CERTIFICATE
  ID_CARD
  DIPLOMA
  CV
  WORK_CERTIFICATE
  LANGUAGE_REGISTRATION
  LANGUAGE_RESULT
  MEDICAL
  VISA_APPROVAL
  OTHER
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  IN_REVIEW
  MODIFICATION_REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  IN_PROGRESS
  SUBMITTED
  VALIDATED
}

enum ProcedureStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

enum ProcedureType {
  REGISTRATION
  CONTRACT_SIGNING
  FEE_PAYMENT
  DOCUMENT_COLLECTION
  DIPLOMA_EQUIVALENCE
  LANGUAGE_TEST_REGISTRATION
  LANGUAGE_TEST_RESULTS
  PROFILE_CREATION
  APPLICATION_SUBMISSION
  MEDICAL_EXAMINATION
  PASSPORT_SUBMISSION
}

// Per-agency customization of which of the fixed ProcedureType steps a new
// application goes through, in what order, and under what display name.
// The underlying `type` stays one of the ProcedureType values (some, like
// DOCUMENT_COLLECTION and PROFILE_CREATION, have real behavior tied to
// them elsewhere) — admins can reorder, rename, re-describe, and
// enable/disable, but not invent an entirely new type.
model StepTemplate {
  id          String        @id @default(uuid())
  agencyId    String
  type        ProcedureType
  label       String
  description String?
  order       Int
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  agency      Agency        @relation(fields: [agencyId], references: [id])

  @@unique([agencyId, type])
  @@index([agencyId])
  @@map("step_template")
}

enum ApplicationType {
  PR
  WORK
  STUDY
  SCHOLARSHIP
}