generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  password         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  role             Role       @default(CLIENT)
  profileCompleted Boolean    @default(false)
  isSuspended      Boolean    @default(false)
  status           UserStatus @default(PENDING)

  // Personal Information
  dateOfBirth      DateTime?
  nationality      String?
  maritalStatus    MaritalStatus?
  numberOfChildren Int            @default(0)
  phoneNumber      String?
  address          String?

  agentId          String?
  applications     Application[]     @relation("ClientApplications")
  documents        Document[]
  messages         Message[]
  accounts         Account[]
  sessions         Session[]
  sentMessages     OfficialMessage[] @relation("SentMessages")
  receivedMessages OfficialMessage[] @relation("ReceivedMessages")
  authoredLogs     AuditLog[]        @relation("AuthorLogs")
  agent            User?             @relation("AgentClients", fields: [agentId], references: [id])
  assignedClients  User[]            @relation("AgentClients")
  assignedApps     Application[]     @relation("AgentApplications")
  
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Application {
  id         String            @id @default(uuid())
  country    String
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  clientId   String
  agentId    String?
  client     User              @relation("ClientApplications", fields: [clientId], references: [id])
  agent      User?             @relation("AgentApplications", fields: [agentId], references: [id])
  procedures Procedure[]
}

model Procedure {
  id            String          @id @default(uuid())
  type          ProcedureType
  description   String?
  status        ProcedureStatus @default(PENDING)
  isLocked      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  applicationId String
  documents     Document[]
  messages      Message[]
  application   Application     @relation(fields: [applicationId], references: [id])
}

model Message {
  id          String    @id @default(uuid())
  content     String
  createdAt   DateTime  @default(now())
  procedureId String
  senderId    String
  procedure   Procedure @relation(fields: [procedureId], references: [id])
  sender      User      @relation(fields: [senderId], references: [id])
}

model OfficialMessage {
  id         String   @id @default(uuid())
  subject    String
  content    String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Document {
  id          String         @id @default(uuid())
  name        String
  fileUrl     String
  type        DocumentType   @default(OTHER)
  status      DocumentStatus @default(UPLOADED)
  uploadedAt  DateTime       @default(now())
  procedureId String
  uploaderId  String
  procedure   Procedure      @relation(fields: [procedureId], references: [id])
  uploader    User           @relation(fields: [uploaderId], references: [id])
}

enum Role {
  ADMIN
  AGENT
  CLIENT
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum ProcedureType {
  PR
  WORK
  STUDY
  SCHOLARSHIP
}

enum DocumentType {
  PASSPORT
  PASSPORT_PHOTO
  BIRTH_CERTIFICATE
  ID_CARD
  DIPLOMA
  CV
  WORK_CERTIFICATE
  LANGUAGE_REGISTRATION
  LANGUAGE_RESULT
  MEDICAL
  VISA_APPROVAL
  OTHER
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  IN_REVIEW
  MODIFICATION_REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ProcedureStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

model AuditLog {
  id        String   @id @default(uuid())
  logNumber Int      @unique @default(autoincrement())
  action    String
  details   String?
  userId    String?
  targetId  String?
  author    User?    @relation("AuthorLogs", fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
